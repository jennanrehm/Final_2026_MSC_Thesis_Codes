# Load Model

def load_model(filename):

    data = np.loadtxt(
        filename,
        encoding="latin1"
    )

    wavelength = data[:, 0]
    flux = data[:, 1]

    sort = np.argsort(wavelength)

    wavelength = wavelength[sort]
    flux = flux[sort]

    mask = (
        np.isfinite(wavelength)
        &
        np.isfinite(flux)
    )

    wavelength = wavelength[mask]
    flux = flux[mask]

    return wavelength, flux


# Find Model Files

def find_model_files():

    model_files = []

    for file in os.listdir(model_folder):

        if (
            file.endswith(".dat")
            and file.startswith("t")
            and not file.startswith("._")
        ):

            match = re.search(
                r"t(\d+)",
                file
            )

            if match:

                temperature = int(
                    match.group(1)
                )

                if (
                    temperature >= temperature_min
                    and temperature <= temperature_max
                ):

                    model_files.append(
                        (
                            temperature,
                            os.path.join(
                                model_folder,
                                file
                            )
                        )
                    )

    return sorted(
        model_files,
        key=lambda x: x[0]
    )


# Fit Model to JWST ends

def fit_model_region(
        w_obs,
        f_obs,
        f_err,
        w_mod,
        f_mod,
        region_min,
        region_max
):

    # Interpolate observation onto model grid

    f_obs_i = np.interp(
        w_mod,
        w_obs,
        f_obs,
        left=np.nan,
        right=np.nan
    )

    f_err_i = np.interp(
        w_mod,
        w_obs,
        f_err,
        left=np.nan,
        right=np.nan
    )


    # Valid fitting region

    fit_mask = (
        (w_mod >= region_min)
        &
        (w_mod <= region_max)
        &
        (w_mod >= w_obs.min())
        &
        (w_mod <= w_obs.max())
        &
        np.isfinite(f_obs_i)
        &
        np.isfinite(f_err_i)
        &
        (f_err_i > 0)
        &
        np.isfinite(f_mod)
    )


    if np.sum(fit_mask) == 0:

        return (
            np.inf,
            np.nan,
            np.full_like(
                f_mod,
                np.nan
            )
        )

    # R^2 / D^2 scaling

    numerator = np.sum(
        (
            f_obs_i[fit_mask]
            *
            f_mod[fit_mask]
        )
        /
        f_err_i[fit_mask]**2
    )


    denominator = np.sum(
        (
            f_mod[fit_mask]**2
        )
        /
        f_err_i[fit_mask]**2
    )


    if (
        denominator == 0
        or not np.isfinite(denominator)
    ):

        return (
            np.inf,
            np.nan,
            np.full_like(
                f_mod,
                np.nan
            )
        )


    scale = (
        numerator /  denominator
    )


    # Scale model

    f_scaled = ( scale  *  f_mod
    )


    # Chi squared

    chi2 = np.sum(
        (( f_obs_i[fit_mask]   - f_scaled[fit_mask] )
            /
            f_err_i[fit_mask])**2
        )

    if not np.isfinite(chi2):

        return (
            np.inf,
            np.nan,
            np.full_like(
                f_mod,
                np.nan
            )
        )


    return (
        chi2,
        scale,
        f_scaled
    )


# Calculate Radius

def calculate_radius(
        scale,
        distance_m
):

    if (
        not np.isfinite(scale)
        or scale <= 0
    ):

        return np.nan

    radius_m = (
        distance_m * np.sqrt(scale)
    )

    radius_RJup = (
        radius_m / R_Jup
    )

    return radius_RJup


# Get Temperature Models

def get_temperature_models(
        results,
        best_T,
        uncertainty=200,
        step=100
):


    #  temperatures around the best fit

    requested_temperatures = np.arange(
        best_T - uncertainty,
        best_T + uncertainty + step,
        step
    )


    # Only retain temperatures that actually exist in the atmospheric model grid.

    available = {
        int(x["T"]): x
        for x in results
    }


    selected = []

    for T in requested_temperatures:
        T = int(T)
        if T in available:

            selected.append(
                available[T]
            )

    return selected


# Interpolate Model

def interpolate_model(
        wavelength,
        flux,
        target_wavelength
):

    if (
        target_wavelength < wavelength.min()
        or
        target_wavelength > wavelength.max()
    ):

        return np.nan


    return np.interp(
        target_wavelength,
        wavelength,
        flux
    )


# Calculate long wavelength log slope

def calculate_log_slope(
        wavelength,
        flux,
        slope_min_um=15.0,
        slope_max_um=None
):

    mask = (
        np.isfinite(wavelength)
        &
        np.isfinite(flux)
        &
        (wavelength > 0)
        &
        (flux > 0)
    )

    wavelength_valid = wavelength[mask]
    flux_valid = flux[mask]


    if len(wavelength_valid) < 2:

        return np.nan, np.nan, np.nan


    model_max = np.max(
        wavelength_valid
    )


    if slope_max_um is None:

        slope_max = model_max

    else:

        slope_max = min(
            slope_max_um,
            model_max
        )


    slope_mask = (
        (wavelength_valid >= slope_min_um)
        &
        (wavelength_valid <= slope_max)
    )


    wavelength_slope = (
        wavelength_valid[slope_mask]
    )

    flux_slope = (
        flux_valid[slope_mask]
    )


    if len(wavelength_slope) < 2:

        return np.nan, np.nan, np.nan


    log_wavelength = np.log10(
        wavelength_slope
    )

    log_flux = np.log10(
        flux_slope
    )


    slope, intercept = np.polyfit(
        log_wavelength,
        log_flux,
        1
    )


    return (
        slope,
        wavelength_slope[0],
        wavelength_slope[-1]
    )


# fitting regions

def determine_fitting_regions(
        w_obs
):

    obs_min = w_obs.min()
    obs_max = w_obs.max()


    # Blue Region

    actual_blue_min = max(
        blue_min,
        obs_min
    )

    actual_blue_max = min(
        blue_max,
        obs_max
    )


    # Red Region

    preferred_red_min = max(
        red_min,
        obs_min
    )

    preferred_red_max = min(
        red_max,
        obs_max
    )

    # If the preferred red region exists, use it. Otherwise use the final 2 microns of JWST (NLTT1011B has shorter spectrum).

    if (
        preferred_red_max > preferred_red_min
    ):

        actual_red_min = preferred_red_min
        actual_red_max = preferred_red_max

        red_region_type = (
            "preferred 10-12 μm region"
        )

    else:

        actual_red_max = obs_max

        actual_red_min = max(
            obs_min,
            obs_max - fallback_red_width
        )

        red_region_type = (
            "fallback final 2 μm of JWST"
        )


    return (
        actual_blue_min,
        actual_blue_max,
        actual_red_min,
        actual_red_max,
        red_region_type
    )


# Hybrid bolometric SED

def build_hybrid_sed(
        blue_result,
        red_result,
        w_obs,
        f_obs
):

    w_blue = blue_result["wave"]
    f_blue = blue_result["flux"]

    w_red = red_result["wave"]
    f_red = red_result["flux"]


    jwst_first = w_obs[0]
    jwst_last = w_obs[-1]


    blue_first = w_blue[0]
    blue_last = w_blue[-1]

    red_first = w_red[0]
    red_last = w_red[-1]


    # 0 to first model point

    w_zero = np.array([
        0.0,
        blue_first
    ])

    f_zero = np.array([
        0.0,
        f_blue[0]
    ])


    # blue model

    blue_mask = (
        (w_blue >= blue_first)
        &
        (w_blue <= jwst_first)
    )


    w_blue_section = w_blue[
        blue_mask
    ]

    f_blue_section = f_blue[
        blue_mask
    ]


    if (
        len(w_blue_section) == 0
        or
        w_blue_section[-1] < jwst_first
    ):

        f_blue_at_jwst = interpolate_model(
            w_blue,
            f_blue,
            jwst_first
        )

        if np.isfinite(
            f_blue_at_jwst
        ):

            w_blue_section = np.append(
                w_blue_section,
                jwst_first
            )

            f_blue_section = np.append(
                f_blue_section,
                f_blue_at_jwst
            )


    # JWST

    w_jwst_section = w_obs.copy()

    f_jwst_section = f_obs.copy()


    # Red Model

    red_mask = (
        (w_red >= jwst_last) & (w_red <= red_last)
    )


    w_red_section = w_red[
        red_mask
    ]

    f_red_section = f_red[
        red_mask
    ]


    if (
        len(w_red_section) == 0
        or
        w_red_section[0] > jwst_last
    ):

        f_red_at_jwst = interpolate_model(
            w_red,
            f_red,
            jwst_last
        )

        if np.isfinite(
            f_red_at_jwst
        ):

            w_red_section = np.insert(
                w_red_section,
                0,
                jwst_last
            )

            f_red_section = np.insert(
                f_red_section,
                0,
                f_red_at_jwst
            )


    return {

        "w_zero": w_zero,
        "f_zero": f_zero,

        "w_blue": w_blue_section,
        "f_blue": f_blue_section,

        "w_jwst": w_jwst_section,
        "f_jwst": f_jwst_section,

        "w_red": w_red_section,
        "f_red": f_red_section,

        "blue_first": blue_first,
        "blue_last": blue_last,

        "red_first": red_first,
        "red_last": red_last,

        "jwst_first": jwst_first,
        "jwst_last": jwst_last

    }


# Calculate Fbol

def calculate_fbol(
        blue_result,
        red_result,
        w_obs,
        f_obs
):

    hybrid = build_hybrid_sed(
        blue_result,
        red_result,
        w_obs,
        f_obs
    )

    # 0 to first model point

    F_blue_zero = np.trapezoid(
        hybrid["f_zero"],
        hybrid["w_zero"]
    )

    # blue model

    if len(
        hybrid["w_blue"]
    ) >= 2:

        F_blue_model = np.trapezoid(
            hybrid["f_blue"],
            hybrid["w_blue"]
        )

    else:

        F_blue_model = 0.0


    F_blue_total = (
        F_blue_zero
        +
        F_blue_model
    )


    # JWST

    F_JWST = np.trapezoid(
        hybrid["f_jwst"],
        hybrid["w_jwst"]
    )


    # Red model

    if len(
        hybrid["w_red"]
    ) >= 2:

        F_red_model = np.trapezoid(
            hybrid["f_red"],
            hybrid["w_red"]
        )

    else:

        F_red_model = 0.0


    # RAYLEIGH-JEANS TAIL

    lambda_last = (
        hybrid["red_last"]
    )

    F_last = (
        red_result["flux"][-1]
    )

    # F_lambda ∝ lambda^-4
    # Integral from lambda_last to infinity:
    # F_RJ = F_last * lambda_last / 3

    F_RJ = (
        F_last
        *
        lambda_last
        /
        3.0
    )


    # Total

    F_bol = (
        F_blue_total + F_JWST + F_red_model + F_RJ
    )


    # percent of JWST is total flux

    if F_bol > 0:

        blue_percent = ( F_blue_total / F_bol * 100 )

        jwst_percent = (
            F_JWST / F_bol * 100
        )

        red_percent = (
            F_red_model / F_bol * 100
        )

        RJ_percent = (
            F_RJ / F_bol * 100
        )

    else:

        blue_percent = np.nan
        jwst_percent = np.nan
        red_percent = np.nan
        RJ_percent = np.nan


    return {

        "F_bol": F_bol,

        "F_blue": F_blue_total,

        "F_JWST": F_JWST,

        "F_red": F_red_model,

        "F_RJ": F_RJ,

        "blue_percent": blue_percent,

        "jwst_percent": jwst_percent,

        "red_percent": red_percent,

        "RJ_percent": RJ_percent,

        "jwst_first": hybrid["jwst_first"],

        "jwst_last": hybrid["jwst_last"],

        "model_first": hybrid["blue_first"],

        "model_last": hybrid["red_last"]

    }


# jwst uncertainty

def calculate_observational_uncertainty(
        w_obs,
        f_err
):
    #Propagate the JWST flux uncertainties through trapezoidal integration used to calculate F_bol.

    #Assumes the individual flux uncertainties are independent.

    #For unevenly spaced wavelength points:

        #sigma_F^2 = 1/4 [sigma_0^2 * dw_0^2+sum(sigma_i^2 * (dw_i + dw_{i+1})^2)
            #+sigma_N^2 * dw_{N-1}^2]
        #where dw_i = wavelength[i+1] - wavelength[i].

    # Wavelength intervals

    dw = np.diff(w_obs)

    # Check that there are enough points

    if len(w_obs) < 2:
        return np.nan

    # Variance of trapezoidal integral

    variance = 0.25 * (

        # First point
        f_err[0]**2 * dw[0]**2
        +
        # Interior points
        np.sum(
            f_err[1:-1]**2 * ( dw[:-1] + dw[1:] )**2
         )
        +
        # Final point
        f_err[-1]**2 *  dw[-1]**2 )

    # Return uncertainty

    return np.sqrt(variance)

