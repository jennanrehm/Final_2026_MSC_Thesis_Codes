    # It does NOT select the next-best chi2 models.
  
    near_blue = get_temperature_models(
        valid_blue_results,
        best_blue["T"],
        uncertainty=temperature_uncertainty,
        step=temperature_step
    )

    near_red = get_temperature_models(
        valid_red_results,
        best_red["T"],
        uncertainty=temperature_uncertainty,
        step=temperature_step
    )

    print(
        "\nModels used for model uncertainty:"
    )

    print(
        "Blue temperatures:",
        [m["T"] for m in near_blue]
    )

    print(
        "Red temperatures:",
        [m["T"] for m in near_red]
    )

    # Calculate Fbol for Temperature grid

    Fbol_models = []


    for bm in near_blue:

        for rm in near_red:

            try:

                test_bolo = calculate_fbol(
                    bm,
                    rm,
                    w_obs,
                    f_obs
                )


                test_Fbol = test_bolo[
                    "F_bol"
                ]


                if np.isfinite(
                    test_Fbol
                ):

                    Fbol_models.append(
                        test_Fbol
                    )

            except Exception as e:

                print(
                    "WARNING: Model uncertainty "
                    "calculation failed:"
                )

                print(e)


    Fbol_models = np.array(
        Fbol_models
    )


    if len(
        Fbol_models
    ) > 1:

        Fbol_model_err = np.std(
            Fbol_models,
            ddof=1
        )

    else:

        Fbol_model_err = 0.0


    # JWST uncertainty

    F_bol_err_obs = (
        calculate_observational_uncertainty(
            w_obs,
            f_err
        )
    )


    # total Fbol uncertainty

    F_bol_err = np.sqrt( F_bol_err_obs**2 + Fbol_model_err**2 )

    # convery to luminosity

    L = (4 * np.pi * distance_m**2 * F_bol)

    L_err_flux = (4 * np.pi * distance_m**2 * F_bol_err )

    L_err_distance = ( 8 * np.pi * distance_m * F_bol * distance_err_m )

    L_err = np.sqrt(L_err_flux**2 + L_err_distance**2)

    # units

    L_ratio = ( L/ L_sun )

    logL = np.log10(L_ratio)

    logL_err = (L_err / L ) / np.log(10)

    # print results

    print(
        "BOLOMETRIC FLUX"
    )

    print(
        f"0 to first model: "
        f"{bolo['F_blue']:.6e} W m^-2 "
        f"({bolo['blue_percent']:.3f}%)"
    )

    print(
        f"JWST: "
        f"{bolo['F_JWST']:.6e} W m^-2 "
        f"({bolo['jwst_percent']:.3f}%)"
    )

    print(
        f"Red model: "
        f"{bolo['F_red']:.6e} W m^-2 "
        f"({bolo['red_percent']:.3f}%)"
    )

    print(
        f"RJ tail: "
        f"{bolo['F_RJ']:.6e} W m^-2 "
        f"({bolo['RJ_percent']:.3f}%)"
    )

    print(
        f"\nTotal Fbol: "
        f"{F_bol:.6e} W m^-2"
    )

    print(
        f"Observed uncertainty: "
        f"{F_bol_err_obs:.6e}"
    )

    print(
        f"Model uncertainty: "
        f"{Fbol_model_err:.6e}"
    )

    print(
        f"Total Fbol uncertainty: "
        f"{F_bol_err:.6e}"
    )

    print(
        "LUMINOSITY"
    )


    print(
        f"L = "
        f"{L:.6e} W"
    )


    print(
        f"L/Lsun = "
        f"{L_ratio:.6e}"
    )


    print(
        f"log(L/Lsun) = "
        f"{logL:.5f} "
        f"+/- "
        f"{logL_err:.5f}"
    )


    # output directory

    target_folder = os.path.join(
        output_folder,
        target_name,
        "Bolometric Luminosity"
    )


    os.makedirs(
        target_folder,
        exist_ok=True
    )


    # plot

    plt.figure(
        figsize=(12, 6)
    )

    # 0 to first model point

    lambda_first = (
        best_blue["wave"][0]
    )

    flux_first = (
        best_blue["flux"][0]
    )

    positive_fluxes = np.concatenate([
        best_blue["flux"][
            best_blue["flux"] > 0
        ],
        f_obs[
            f_obs > 0
        ],
        best_red["flux"][
            best_red["flux"] > 0
        ]
    ])


    if len(
        positive_fluxes
    ) > 0:

        plot_floor = (
            np.min(positive_fluxes)
            *
            0.05
        )

    else:

        plot_floor = 1e-30


    plt.plot(
        [0.0, lambda_first],
        [plot_floor, flux_first],
        color="gray",
        linestyle=":",
        linewidth=1.6,
        alpha=0.6,
        label="Wien's tail"
    )


    # blue model

    blue_plot_mask = (
        (best_blue["wave"] >= lambda_first)
        &
        (best_blue["wave"] <= w_obs.min())
    )


    if np.sum(
        blue_plot_mask
    ) > 0:

        plt.plot(
            best_blue["wave"][
                blue_plot_mask
            ],
            best_blue["flux"][
                blue_plot_mask
            ],
            color="blue",
            linewidth=2,
            label=(
                f"Diamondback model "
                f"({best_blue['T']} K)"
            )
        )


    # JWST

    plt.plot(
        w_obs,
        f_obs,
        color="black",
        linewidth=1.3,
        label="JWST"
    )


    # red model

    red_plot_mask = (
        best_red["wave"]
        >=
        w_obs.max()
    )


    if np.sum(
        red_plot_mask
    ) > 0:

        plt.plot(
            best_red["wave"][
                red_plot_mask
            ],
            best_red["flux"][
                red_plot_mask
            ],
            color="red",
            linewidth=2,
            label=(
                f"Diamondback model "
                f"({best_red['T']} K)"
            )
        )


    # RAYLEIGH-JEANS TAIL

    lambda_last = (
        best_red["wave"][-1]
    )

    F_last = (
        best_red["flux"][-1]
    )


    if lambda_last < plot_max_wavelength:

        w_RJ_plot = np.linspace(
            lambda_last,
            plot_max_wavelength,
            300
        )


        f_RJ_plot = (
            F_last
            *
            (
                lambda_last
                /
                w_RJ_plot
            )**4
        )


        plt.plot(
            w_RJ_plot,
            f_RJ_plot,
            color="green",
            linestyle=":",
            linewidth=1.8,
            alpha=0.7,
            label="Rayleigh–Jeans tail"
        )


    # axes

    plt.xlabel(
        "Wavelength (μm)",
        fontsize=15
    )


    plt.ylabel(
        r"Flux ($W\,m^{-2}\,\mu m^{-1}$)",
        fontsize=15
    )


    plt.xlim(
        0,
        plot_max_wavelength
    )


    plt.xticks(
        np.arange(
            0,
            plot_max_wavelength + 2.5,
            2.5
        )
    )


    plt.yscale(
        "log"
    )


    plt.legend(
        fontsize=15,
        loc="best"
    )


    # Save Figure

    plot_filename = os.path.join(
        target_folder,
        f"Hybrid_Bolo_Lum_RJ_{target_name}.png"
    )


    plt.savefig(
        plot_filename,
        dpi=300,
        bbox_inches="tight"
    )


    plt.close()


    print(
        f"\nPlot saved to:"
    )

    print(
        plot_filename
    )


    # Save results

    all_results.append({

        "Target":
            target_name,

        "Distance_pc":
            distance_pc,

        "Distance_error_pc":
            distance_err_pc,

        # Blue model

        "Blue_Model":
            best_blue["file"],

        "Blue_Teff_K":
            best_blue["T"],

        "Blue_chi2":
            best_blue["chi2"],

        "Blue_R2_D2":
            blue_R2_D2,

        "Blue_Radius_RJup":
            blue_radius_RJup,

        # Red model

        "Red_Model":
            best_red["file"],

        "Red_Teff_K":
            best_red["T"],

        "Red_chi2":
            best_red["chi2"],

        "Red_R2_D2":
            red_R2_D2,

        "Red_Radius_RJup":
            red_radius_RJup,

        # Fitting regions

        "Blue_fit_min_um":
            actual_blue_min,

        "Blue_fit_max_um":
            actual_blue_max,

        "Red_fit_min_um":
            actual_red_min,

        "Red_fit_max_um":
            actual_red_max,

        # long wavelength slope

        "Long_wavelength_log_slope":
            red_log_slope,

        "Slope_start_um":
            slope_start_um,

        "Slope_end_um":
            slope_end_um,

        # wavelength range

        "JWST_min_um":
            bolo["jwst_first"],

        "JWST_max_um":
            bolo["jwst_last"],

        "Model_min_um":
            bolo["model_first"],

        "Model_max_um":
            bolo["model_last"],

        # flux

        "F_blue":
            bolo["F_blue"],

        "F_JWST":
            bolo["F_JWST"],

        "F_red":
            bolo["F_red"],

        "F_RJ":
            bolo["F_RJ"],

        "F_bol":
            F_bol,

        "F_bol_error":
            F_bol_err,

        # uncertainties

        "Observed_spectrum_uncertainty":
            F_bol_err_obs,

        "Model_temperature_uncertainty":
            Fbol_model_err,

        # contributions

        "Blue_percent":
            bolo["blue_percent"],

        "JWST_percent":
            bolo["jwst_percent"],

        "Red_model_percent":
            bolo["red_percent"],

        "RJ_tail_percent":
            bolo["RJ_percent"],

        # luminosity

        "Luminosity_W":
            L,

        "Luminosity_error_W":
            L_err,

        "L_Lsun":
            L_ratio,

        "log_L_Lsun":
            logL,

        "log_L_error":
            logL_err

    })


# save all targets

results_df = pd.DataFrame(
