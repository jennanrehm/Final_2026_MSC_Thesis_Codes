# Fit the complete ElfOwl grid

def fit_elfowl_grid(

    obspec,
    distance_pc,
    distance_error_pc,
    reference_teff,
    all_models

):

    distance_m = (

        distance_pc *  PC_TO_M
    )

    jwst_wavelength = obspec[0]

    jwst_min = np.min(
        jwst_wavelength
    )

    jwst_max = np.max(
        jwst_wavelength
    )

    selected_temperatures = (
        select_temperature_grid(
            all_models,
            reference_teff

        )
    )

    print()
    print(
        "Temperatures selected:"
    )

    print(
        selected_temperatures.astype(int)
    )

    selected_models = []

    for filepath in all_models:

        params = parse_elfowl_filename(
            filepath
        )

        if params is None:
            continue

        if any(
            np.isclose(
                params["Teff"],
                temperature,
                atol=0.01
            )

            for temperature in
            selected_temperatures

        ):

            selected_models.append(
                (
                    filepath,
                    params
                )

            )

    print()
    print(
        f"Models selected: "
        f"{len(selected_models)}"
    )

    print(

        f"JWST wavelength range: "
        f"{jwst_min:.3f} - "
        f"{jwst_max:.3f} μm"

    )

    results = []

    number_skipped = 0
    number_fitted = 0
    number_bad = 0

    for index, (
        filepath,
        params

    ) in enumerate(

        selected_models,
        start=1

    ):

        filename = os.path.basename(
            filepath
        )

        try:

            model_spectrum = (
                load_elfowl_spectrum(
                    filepath
                )
            )

            model_wavelength = (
                model_spectrum[0]
            )

            model_flux_raw = (
                model_spectrum[1]
            )

            if not has_full_coverage(

                model_wavelength,

                jwst_wavelength

            ):

                number_skipped += 1
                continue

            model_flux = (
                elfowl_to_jwst_units(
                    model_flux_raw
                )
            )

            modspec = np.array([

                model_wavelength,
                model_flux

            ])

            model_chi2, R2D2, convolved_model = (
                calculate_chi2(

                    obspec,
                    modspec

                )
            )

            if (

                not np.isfinite(
                    model_chi2
                )
                or
                not np.isfinite(
                    R2D2
                )

            ):
                number_bad += 1
                continue

            radius = (

                np.sqrt(
                    R2D2
                )
                *
                distance_m
                /
                RJUP

            )

            results.append({

                "model":
                    filename,

                "filepath":
                    filepath,

                "Teff":
                    params["Teff"],

                "logg":
                    params["logg"],

                "gravity":
                    params["gravity"],

                "MH":
                    params["MH"],

                "CO":
                    params["CO"],

                "logKzz":
                    params["logKzz"],

                "chi2":
                    model_chi2,

                "R2D2":
                    R2D2,

                "radius":
                    radius

            })

            number_fitted += 1

        except Exception as error:

            number_bad += 1
            if number_bad <= 10:

                print()
                print(
                    f"Error while fitting {filename}:"
                )

                print(error)

        if (
            index == 1
            or
            index % 50 == 0
            or
            index == len(
                selected_models
            )

        ):


            print(

                f"[{index}/"
                f"{len(selected_models)}] "
                f"fitted={number_fitted} "
                f"skipped={number_skipped} "
                f"bad={number_bad} "
            )

    results_df = pd.DataFrame(
        results
    )

    if len(results_df) == 0:

        return (
            results_df,
            None,
            None,
            np.nan,
            number_skipped,
            number_fitted,
            number_bad
        )

    results_df = (

        results_df

        .sort_values(
            "chi2"
        )

        .reset_index(
            drop=True
        )

    )

    best_model = results_df.iloc[
        0
    ]

    best_raw = (
        load_elfowl_spectrum(
            best_model["filepath"]
        )
    )

    best_model_flux = (
        elfowl_to_jwst_units(
            best_raw[1]
        )
    )

    best_modspec = np.array([
        best_raw[0],
        best_model_flux
    ])

    best_chi2_value, best_R2D2, best_convolved = (
        calculate_chi2(
            obspec,
            best_modspec
        )
    )

    best_flux = (
        best_R2D2 * best_convolved
    )

    radius_error = monte_carlo_radius(

        obspec,

        best_convolved,

        best_model["radius"],

        best_model["R2D2"],

        distance_pc,

        distance_error_pc

    )

    return (

        results_df,
        best_model,
        best_flux,
        radius_error,
        number_skipped,
        number_fitted,
        number_bad
    )

