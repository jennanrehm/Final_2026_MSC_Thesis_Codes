# Extract parameters from an ElfOwl filename

def parse_elfowl_filename(filepath):

    #Extract atmospheric parameters from an ElfOwl filename.

    #Expected format:
        #spectra_logzz_2.0_teff_1600.0_grav_17.0_mh_0.7_co_0.5.nc

    #Parameters:logKzz, Teff, gravity, [M/H], C/O

    #ElfOwl gravity is given in m/s^2.
        #g_cgs = g_SI * 100
        #logg = log10(g_cgs)

    filename = os.path.basename(
        filepath
    )

    try:

        logkzz = float(
            re.search(
                r"logzz_(-?\d+(?:\.\d+)?)",
                filename
            ).group(1)
        )

        teff = float(
            re.search(
                r"teff_(-?\d+(?:\.\d+)?)",
                filename
            ).group(1)
        )

        gravity = float(
            re.search(
                r"grav_(-?\d+(?:\.\d+)?)",
                filename
            ).group(1)
        )

        mh = float(
            re.search(
                r"mh_(-?\d+(?:\.\d+)?)",
                filename
            ).group(1)
        )

        co = float(
            re.search(
                r"co_(-?\d+(?:\.\d+)?)",
                filename
            ).group(1)
        )

        gravity_cgs = gravity * 100.0

        logg = np.log10(
            gravity_cgs
        )

        return {

            "Teff": teff,

            "logg": logg,

            "gravity": gravity,

            "MH": mh,

            "CO": co,

            "logKzz": logkzz

        }

    except Exception:

        return None


# Load a JWST spectrum

def load_jwst_spectrum(target_name):

    filepath = os.path.join(

        spectrum_folder,

        f"{target_name}_spectrum.txt"

    )

    data = np.loadtxt(
        filepath
    )

    jwst_wavelength = data[:, 0]

    jwst_flux = data[:, 1]

    jwst_uncertainty = data[:, 2]

    valid = (

        np.isfinite(jwst_wavelength)

        &

        np.isfinite(jwst_flux)

        &

        np.isfinite(jwst_uncertainty)

        &

        (jwst_wavelength > 0)

        &

        (jwst_uncertainty > 0)

    )

    jwst_wavelength = jwst_wavelength[valid]

    jwst_flux = jwst_flux[valid]

    jwst_uncertainty = jwst_uncertainty[valid]

    order = np.argsort(
        jwst_wavelength
    )

    jwst_wavelength = jwst_wavelength[order]

    jwst_flux = jwst_flux[order]

    jwst_uncertainty = jwst_uncertainty[order]

    return np.array([

        jwst_wavelength,
        jwst_flux,
        jwst_uncertainty

    ])


# Load an ElfOwl model spectrum

def load_elfowl_spectrum(filepath):
    with xr.open_dataset(filepath) as dataset:
        wavelength = np.asarray(dataset["wavelength"].values).squeeze()
        flux = np.asarray(dataset["flux"].values).squeeze()

    order = np.argsort(wavelength)

    wavelength = wavelength[order]
    flux = flux[order]

    return np.array([wavelength, flux])

# Convert ElfOwl flux into JWST units

def elfowl_to_jwst_units(flux):

    
    #Convert:
        #erg cm^-2 s^-1 cm^-1
    #to:
        #W m^-2 micron^-1

    return flux * 1e-7


# Check model wavelength coverage

def has_full_coverage(

    model_wavelength,
    jwst_wavelength

):

    model_min = np.min(
        model_wavelength
    )

    model_max = np.max(
        model_wavelength
    )

    jwst_min = np.min(
        jwst_wavelength
    )

    jwst_max = np.max(
        jwst_wavelength
    )

    return (

        model_min
        <=
        jwst_min + WAVELENGTH_TOLERANCE

        and

        model_max
        >=
        jwst_max - WAVELENGTH_TOLERANCE

    )


# Convolve model to JWST resolution

def convolve_model(

    obspec,
    modspec,
    resolution=MODEL_RESOLUTION

):

    jwst_wavelength = obspec[0]

    model_wavelength = modspec[0]

    model_flux = modspec[1]

    number_of_observed_points = len(
        jwst_wavelength
    )

    convolved_flux = np.zeros(
        number_of_observed_points
    )

    delta_previous = np.abs(

        jwst_wavelength
        -
        np.roll( jwst_wavelength, 1
        )
    )

    delta_next = np.abs(

        jwst_wavelength
        -
        np.roll(
            jwst_wavelength,
            -1
        )

    )

    local_delta_wavelength = ( 0.5 * ( delta_previous + delta_next )

    )

    if number_of_observed_points > 2:

        local_delta_wavelength[0] = (
            local_delta_wavelength[1]
        )

        local_delta_wavelength[-1] = (
            local_delta_wavelength[-2]
        )

    for i in range(
        number_of_observed_points
    ):

        current_wavelength = (
            jwst_wavelength[i]
        )

        current_delta_wavelength = (
            local_delta_wavelength[i]
        )

        sigma = (

            current_delta_wavelength * resolution / 2.355

        )

        if (

            not np.isfinite(sigma)

            or

            sigma <= 0

        ):

            convolved_flux[i] = np.interp(

                current_wavelength,

                model_wavelength,

                model_flux

            )

            continue

        lower_wavelength = (

            current_wavelength  - GAUSSIAN_SIGMA_LIMIT  *  sigma

        )

        upper_wavelength = (

            current_wavelength + GAUSSIAN_SIGMA_LIMIT * sigma

        )

        left_index = np.searchsorted(

            model_wavelength,

            lower_wavelength,

            side="left"

        )

        right_index = np.searchsorted(

            model_wavelength,

            upper_wavelength,

            side="right"

        )

        if right_index <= left_index:

            convolved_flux[i] = np.interp(

                current_wavelength,

                model_wavelength,

                model_flux

            )

            continue

        local_wavelength = model_wavelength[
            left_index:right_index
        ]

        local_flux = model_flux[
            left_index:right_index
        ]

        gaussian = np.exp(

            -(( local_wavelength - current_wavelength )**2 )
            /
            ( 2 * sigma**2 ) )

        gaussian_sum = np.sum(
            gaussian
        )

        if (

            not np.isfinite(
                gaussian_sum
            )

            or

            gaussian_sum <= 0

        ):

            convolved_flux[i] = np.interp(

                current_wavelength,

                model_wavelength,

                model_flux

            )

            continue

        gaussian /= gaussian_sum

        convolved_flux[i] = np.sum(

            gaussian
            *
            local_flux

        )

    return convolved_flux


# 15. Calculate chi-squared and R^2 / D^2 scaling


def calculate_chi2(

    obspec,
    modspec

):

    convolved_model = convolve_model(

        obspec,
        modspec

    )

    if not np.all(
        np.isfinite(
            convolved_model
        )
    ):

        return (
            np.inf,
            np.nan,
            None
        )

    numerator = np.sum(
        obspec[1] * convolved_model / obspec[2]**2
    )

    denominator = np.sum(
        convolved_model**2
        /
        obspec[2]**2
    )

    if (

        denominator <= 0
        or
        not np.isfinite(
            denominator
        )
    ):

        return (
            np.inf,
            np.nan,
            None
        )

    R2D2 = (
        numerator / denominator
    )

    if (

        R2D2 <= 0
        or
        not np.isfinite(
            R2D2
        )
    ):
        return (
            np.inf,
            np.nan,
            None
        )

    residuals = ( obspec[1] - R2D2 * convolved_model ) / obspec[2]

    raw_chi2 = np.sum(
        residuals**2
    )

    number_of_points = len(
        obspec[0]
    )

    reduced_chi2 = (
        raw_chi2  / number_of_points
    )

    return (
        reduced_chi2,
        R2D2,
        convolved_model
    )

# radius uncertainty 

def monte_carlo_radius(
    obspec,
    model_flux,
    best_radius,
    best_R2D2,
    distance_pc,
    distance_error_pc,
    n_samples=1000
):

    radius_samples = []

    denominator = np.sum(
        model_flux**2 / obspec[2]**2
    )

    if denominator <= 0:

        return np.nan

    for _ in range(
        n_samples
    ):
        flux_sample = (
            obspec[1] + np.random.normal(0, obspec[2])
        )

        distance_sample = np.random.normal(

            distance_pc,
            distance_error_pc
        )

        if distance_sample <= 0:

            continue

        numerator = np.sum(

            flux_sample * model_flux / obspec[2]**2
        )

        R2D2_sample = (
            numerator / denominator

        )

        if R2D2_sample <= 0:
            continue

        radius_sample = (
            best_radius * np.sqrt( R2D2_sample/best_R2D2)
            * distance_sample / distance_pc
        )

        radius_samples.append(
            radius_sample
        )

    if len(radius_samples) < 2:

        return np.nan

    return np.std(
        radius_samples
    )

# Select temperature grid

def select_temperature_grid(

    all_models,
    reference_teff

):
    available_temperatures = []

    for filepath in all_models:

        params = parse_elfowl_filename(
            filepath
        )

        if params is None:

            continue

        available_temperatures.append(
            params["Teff"]
        )

    available_temperatures = np.array(

        sorted(
            np.unique(
                available_temperatures
            )
        )
    )

    if not USE_TEMPERATURE_WINDOW:
        return available_temperatures

    lower_temperature = (
        reference_teff - TEMPERATURE_WINDOW
    )

    upper_temperature = (
        reference_teff +  TEMPERATURE_WINDOW
    )

    selected_temperatures = (
        available_temperatures[
            (
                available_temperatures
                >=
                lower_temperature
            )
            &
            (
                available_temperatures
                <=
                upper_temperature
            )
        ]
    )

    return selected_temperatures


