        )

    if len(allowed_tracks) > 0:

        print(
            "\nAllowed evolutionary mass tracks:"
        )

        print(
            ", ".join(
                f"{item['M'] * 1000:g}"
                for item in allowed_tracks
            )
            + " MJup"
        )

    # plots

    make_evolutionary_plots(
