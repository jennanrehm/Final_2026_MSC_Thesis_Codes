# Match Metallicity to avaliable grid

def nearest_metallicity(
    value
):

    available = np.array([
        -0.5,
        0.0,
        0.5
    ])

    return available[
        np.argmin(
            np.abs(
                available - value
            )
        )
    ]


# Load Bobcat Evolutionary Grid

def load_bobcat_grid(
    metallicity
):

    mh = nearest_metallicity(
        metallicity
    )

    filename = BOBCAT_EVO_FILES[
        mh
    ]

    print(
        f"      Loading Bobcat grid "
        f"[M/H] = {mh:+.1f}: "
        f"{os.path.basename(filename)}"
    )

    grid = pd.read_csv(
        filename,
        sep=r"\s+"
    )

    for column in [
        "age",
        "M",
        "logL",
        "R"
    ]:

        grid[column] = pd.to_numeric(
            grid[column],
            errors="coerce"
        )

    grid = grid.dropna(
        subset=[
            "age",
            "M",
            "logL",
            "R"
        ]
    ).copy()

    return grid, mh


# Load Red Diamondback Evolutionary Grid

def load_diamondback_grid(
    metallicity
):

    if metallicity <= -0.25:

        evo_file = (
            DIAMONDBACK_EVO_FILES[-0.5]
        )

        used_mh = -0.5

    elif metallicity >= 0.25:

        evo_file = (
            DIAMONDBACK_EVO_FILES[0.5]
        )

        used_mh = 0.5

    else:

        evo_file = (
            DIAMONDBACK_EVO_FILES[0.0]
        )

        used_mh = 0.0

    print(
        evo_file
    )

    rows = []

    with open(
        evo_file,
        "r",
        encoding="utf-8"
    ) as f:

        for line in f:

            line = line.strip()

            if not line:
                continue

            if line.startswith(
                "age(Gyr)"
            ):
                continue

            parts = line.split()

            if len(parts) != 6:
                continue

            try:

                values = [
                    float(x)
                    for x in parts
                ]

            except ValueError:

                continue

            rows.append(
                values
            )

    grid = pd.DataFrame(
        rows,
        columns=[
            "age",
            "M",
            "logL",
            "Teff",
            "logg",
            "R"
        ]
    )

    grid = grid.dropna().copy()

    grid = grid.sort_values(
        [
            "M",
            "age"
        ]
    ).reset_index(
        drop=True
    )

    print(
        f"Loaded {len(grid)} "
        f"Diamondback evolutionary model points."
    )

    print(
        f"Age range: "
        f"{grid['age'].min():.4f} - "
        f"{grid['age'].max():.4f} Gyr"
    )

    print(
        f"Mass range: "
        f"{grid['M'].min():.5f} - "
        f"{grid['M'].max():.5f} Msun"
    )

    print(
        f"log(L/Lsun) range: "
        f"{grid['logL'].min():.4f} - "
        f"{grid['logL'].max():.4f}"
    )

    return grid, used_mh


# Find Simultaneous age and luminosity intersection

def find_track_intersection(
    track,
    age_min,
    age_max,
    logL_min,
    logL_max,
    interpolation_points=5000
):

    track = (
        track
        .sort_values("age")
        .drop_duplicates(
            subset="age"
        )
        .copy()
    )

    if len(track) < 2:

        return None

    ages = track["age"].values
    logLs = track["logL"].values
    radii = track["R"].values

    # Check age overlap

    if (
        age_max < ages.min()
        or
        age_min > ages.max()
    ):

        return None

    # Restrict interpolation to allowed age region

    restricted_min = max(
        age_min,
        ages.min()
    )

    restricted_max = min(
        age_max,
        ages.max()
    )

    if restricted_min >= restricted_max:

        return None

    # Dense age grid

    dense_age = np.linspace(
        restricted_min,
        restricted_max,
        interpolation_points
    )

    dense_logL = np.interp(
        dense_age,
        ages,
        logLs
    )

    dense_radius = np.interp(
        dense_age,
        ages,
        radii
    )

    # Identify simultaneous luminosity constraint

    inside_luminosity = (
        (dense_logL >= logL_min)
        &
        (dense_logL <= logL_max)
    )

    if not np.any(
        inside_luminosity
    ):

        return None

    valid_age = dense_age[
        inside_luminosity
    ]

    valid_logL = dense_logL[
        inside_luminosity
    ]

    valid_radius = dense_radius[
        inside_luminosity
    ]

    # Simultaneous intersection

    return {

        "age_min":
            valid_age.min(),

        "age_max":
            valid_age.max(),

        "logL_min":
            valid_logL.min(),

        "logL_max":
            valid_logL.max(),

        "radius_min":
            valid_radius.min(),

        "radius_max":
            valid_radius.max()
    }


# Find all allowed mass tracks

def find_allowed_tracks(
    evo,
    age_min,
    age_max,
    logL_min,
    logL_max
):

    allowed_tracks = []

    for mass in np.sort(
        evo["M"].unique()
    ):

        track = evo[
            evo["M"] == mass
        ].copy()

        intersection = (
            find_track_intersection(
                track=track,
                age_min=age_min,
                age_max=age_max,
                logL_min=logL_min,
                logL_max=logL_max
            )
        )

        if intersection is not None:

            allowed_tracks.append({

                "M": mass,

                "age_min":
                    intersection[
                        "age_min"
                    ],

                "age_max":
                    intersection[
                        "age_max"
                    ],

                "logL_min":
                    intersection[
                        "logL_min"
                    ],

                "logL_max":
                    intersection[
                        "logL_max"
                    ],

                "radius_min":
                    intersection[
                        "radius_min"
                    ],

                "radius_max":
                    intersection[
                        "radius_max"
                    ]
            })

    return allowed_tracks


# derive Teff and log(g)

# Radius midpoint:
#     R_mid = (R_min + R_max) / 2
# Radius uncertainty:
#     sigma_R = (R_max - R_min) / 2
# Teff:
#     T = [L / (4 pi sigma R^2)]^(1/4)
# Luminosity uncertainty:
#     sigma_L = ln(10) * L * sigma_logL
# Teff uncertainty:
#     sigma_T^2 = (dT/dL)^2 sigma_L^2 + (dT/dR)^2 sigma_R^2
# logg:
#     g = GM/R^2
#     logg = log10(g)
# Uncertainty:
#     sigma_logg = 1/ln(10) * sqrt[(sigma_M/M)^2 +(2 sigma_R/R)^2]

def derive_evolutionary_parameters(
    mass_min_mjup,
    mass_max_mjup,
    radius_min_rjup,
    radius_max_rjup,
    logL,
    logL_error
):


    # Midpoint values

    mass_mid_mjup = (
        mass_min_mjup + mass_max_mjup ) / 2.0

    radius_mid_rjup = (
        radius_min_rjup +   radius_max_rjup ) / 2.0

    # uncertanties

    mass_error_mjup = (
        mass_max_mjup - mass_min_mjup ) / 2.0

    radius_error_rjup = (
        radius_max_rjup - radius_min_rjup ) / 2.0

    # convert units

    mass_kg = (
        mass_mid_mjup * M_JUP
    )

    mass_error_kg = (
        mass_error_mjup * M_JUP
    )

    radius_m = (
        radius_mid_rjup * R_JUP
    )

    radius_error_m = (
        radius_error_rjup * R_JUP
    )

    # Luminosity

    luminosity_w = ( 10.0 ** logL ) * L_SUN

    luminosity_error_w = (
        np.log(10.0) * luminosity_w * logL_error
    )

    # effective temperature

    teff = (
        luminosity_w /
        ( 4.0 * np.pi * SIGMA_SB * radius_m ** 2 )
    ) ** 0.25

    # Teff uncertainty from luminosity

    teff_error_lum = (
        teff * (
            luminosity_error_w / (4.0 * luminosity_w)
        )
    )

    # Teff uncertainty from radius

    teff_error_radius = (
        teff *
        ( radius_error_m / (2.0 * radius_m)
        )
    )

    # Combine Teff uncertainties in quadrature

    teff_error = np.sqrt(
        teff_error_lum ** 2 + teff_error_radius ** 2
    )

    # Surface Gravity

    gravity = (
        G * mass_kg / radius_m ** 2
    )

    logg = np.log10(
        gravity * 100.0
    )

    # logg uncertainty

    relative_mass_error = (
        mass_error_kg / mass_kg
    )

    relative_radius_error = (
        radius_error_m / radius_m
    )

    logg_error = (
        1.0 / np.log(10.0) *
        np.sqrt( relative_mass_error ** 2 +
            ( 2.0 * relative_radius_error ) ** 2
        )
    )

    # return
    return {
        "Evolutionary_Mass_Mid_MJup":
            mass_mid_mjup,

        "Evolutionary_Mass_Error_MJup":
            mass_error_mjup,

        "Evolutionary_Radius_Mid_RJup":
            radius_mid_rjup,

        "Evolutionary_Radius_Error_RJup":
            radius_error_rjup,

        "Evolutionary_Teff_K":
            teff,

        "Evolutionary_Teff_Error_K":
            teff_error,

        "Evolutionary_logg":
            logg,

        "Evolutionary_logg_Error":
            logg_error,

        "Absolute_Luminosity_W":
            luminosity_w,

        "Absolute_Luminosity_Error_W":
            luminosity_error_w
    }


# label panel

def add_panel_label(
    ax,
    text
):

    ax.text(
        0.02,
        0.03,
        text,
        transform=ax.transAxes,
        fontsize=11,
        ha="left",
        va="bottom",
        bbox=dict(
            boxstyle="round,pad=0.25",
            facecolor="white",
            edgecolor="none",
            alpha=0.65
        ),
        zorder=10
    )


# make plots

def make_evolutionary_plots(
    target,
    model_name,
    evo,
    allowed_tracks,
    age_min,
    age_max,
    logL,
    logL_error,
    atmos_radius,
    atmos_radius_error
):

    if len(allowed_tracks) == 0:

        print(
            "No allowed evolutionary "
            "mass tracks available for plotting."
        )

        return

    allowed_masses = np.array([
        item["M"]
        for item in allowed_tracks
    ])

    print(
        "Allowed evolutionary mass tracks:"
    )

    print(
        ", ".join(
            f"{mass * 1000:g} MJup"
            for mass in allowed_masses
        )
    )

    # age limits

    age_span = (
        age_max -
        age_min
    )

    age_padding = max(
        AGE_PADDING_FRACTION *
        age_span,
        MIN_AGE_PADDING
    )

    zoom_xmin = max(
        0,
        age_min -
        age_padding
    )

    zoom_xmax = (
        age_max +
        age_padding
    )

    full_xmin = max(
        0,
        evo["age"].min()
    )

    full_xmax = evo["age"].max()

    # luminosity limits

    luminosity_lower = (
        logL - logL_error
    )

    luminosity_upper = (
        logL + logL_error
    )

    luminosity_span = (
        luminosity_upper - luminosity_lower
    )

    minimum_luminosity_span = 0.20

    plotting_luminosity_span = max(
        luminosity_span,
        minimum_luminosity_span
    )

    luminosity_padding = (
        0.5 * plotting_luminosity_span
    )

    luminosity_ymin = (
        logL - plotting_luminosity_span / 2 - luminosity_padding
    )

    luminosity_ymax = (
        logL + plotting_luminosity_span / 2 + luminosity_padding
    )

    # radius limits

    radius_lower = (
        atmos_radius - atmos_radius_error
    )

    radius_upper = (
        atmos_radius + atmos_radius_error
    )

    radius_span = (
        radius_upper - radius_lower
    )

    minimum_radius_span = 0.20

    plotting_radius_span = max(
        radius_span,
        minimum_radius_span
    )

    radius_padding = (
        0.5 *  plotting_radius_span
    )

    radius_ymin = max(
        0.0,
        atmos_radius - plotting_radius_span / 2 - radius_padding
    )

    radius_ymax = (
        atmos_radius +
        plotting_radius_span / 2 +
        radius_padding
    )

    panel_text = (
        f"{target} - {model_name}"
    )

    # luminosity plot

    def draw_luminosity_plot(
        xmin,
        xmax,
        suffix
    ):

        fig, ax = plt.subplots(
            figsize=(8, 6),
            dpi=180
        )

        for item in allowed_tracks:

            mass = item["M"]

            track = evo[
                evo["M"] == mass
            ].sort_values(
                "age"
            )

            if len(track) == 0:
                continue

            ax.plot(
                track["age"],
                track["logL"],
                lw=1.5,
                label=f"{mass * 1000:g} MJup",
                zorder=2
            )

        ax.axvspan(
            age_min,
            age_max,
            alpha=0.12,
            label="Allowed age range",
            zorder=0
        )

        ax.axhspan(
            luminosity_lower,
            luminosity_upper,
            alpha=0.30,
            label=(
                r"Observed $\log(L_{\rm bol}/L_\odot)$ "
                r"($1\sigma$)"
            ),
            zorder=4
        )

        ax.axhline(
            y=logL,
            linestyle="--",
            lw=1.2,
            color="black",
            label=(
                r"Observed $\log(L_{\rm bol}/L_\odot)$"
            ),
            zorder=5
        )

        ax.set_xlim(
            xmin,
            xmax
        )

        ax.set_ylim(
            luminosity_ymin,
            luminosity_ymax
        )

        ax.set_xlabel(
            "Age (Gyr)",
            fontsize=11
        )

        ax.set_ylabel(
            r"$\log(L_{\rm bol}/L_{\odot})$",
            fontsize=11
        )

        ax.grid(
            alpha=0.25,
            zorder=1
        )

        add_panel_label(
            ax,
            panel_text
        )

        ax.legend(
            fontsize=10,
            ncol=2,
            loc="best",
            framealpha=0.7
        )

        fig.tight_layout()

        output = os.path.join(
            RESULTS_DIR,
            f"{target}_{model_name}_"
            f"Luminosity_{suffix}.png"
        )

        fig.savefig(
            output,
            dpi=300,
            bbox_inches="tight"
        )

        plt.close(fig)

        print(
            f"Saved luminosity plot:\n"
            f"    {output}"
        )

    # radius plot

    def draw_radius_plot(
        xmin,
        xmax,
        suffix
    ):

        fig, ax = plt.subplots(
            figsize=(8, 6),
            dpi=180
        )

        for item in allowed_tracks:

            mass = item["M"]

            track = evo[
                evo["M"] == mass
            ].sort_values(
                "age"
            )

            if len(track) == 0:
                continue

            radius_rjup = (
                track["R"]   /  0.1028
            )

            ax.plot(
                track["age"],
                radius_rjup,
                lw=1.5,
                label=f"{mass * 1000:g} MJup"
            )

        ax.axhspan(
            radius_lower,
            radius_upper,
            alpha=0.20,
            label=(
                "Atmospheric radius "
                r"$\pm1\sigma$"
            )
        )

        ax.axhline(
            y=atmos_radius,
            linestyle="--",
            lw=1.2,
            color="black",
            label="Atmospheric radius"
        )

        ax.axvspan(
            age_min,
            age_max,
            alpha=0.12,
            label="Allowed age range"
        )

        ax.set_xlim(
            xmin,
            xmax
        )

        ax.set_ylim(
            radius_ymin,
            radius_ymax
        )

        ax.set_xlabel(
            "Age (Gyr)",
            fontsize=11
        )

        ax.set_ylabel(
            r"Radius ($R_{\rm Jup}$)",
            fontsize=11
        )

        ax.grid(
            alpha=0.25
        )

        add_panel_label(
            ax,
            panel_text
        )

        ax.legend(
            fontsize=10,
            ncol=2,
            loc="best",
            framealpha=0.7
        )

        fig.tight_layout()

        output = os.path.join(
            RESULTS_DIR,
            f"{target}_{model_name}_"
            f"Radius_{suffix}.png"
        )

        fig.savefig(
            output,
            dpi=300,
            bbox_inches="tight"
        )

        plt.close(fig)

        print(
            f"Saved radius plot:\n"
            f"    {output}"
        )

    # all 4 plots

    draw_luminosity_plot(
        xmin=full_xmin,
        xmax=full_xmax,
        suffix="FULL"
    )

    draw_luminosity_plot(
        xmin=zoom_xmin,
        xmax=zoom_xmax,
        suffix="ZOOM"
    )

    draw_radius_plot(
        xmin=full_xmin,
        xmax=full_xmax,
        suffix="FULL"
    )

