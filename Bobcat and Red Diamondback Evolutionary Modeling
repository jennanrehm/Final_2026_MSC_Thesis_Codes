            atmos_radius,

        "Bobcat_Atmos_Radius_Error_RJup":
            atmos_radius_error,

        "Bobcat_Evo_Mass_Min_MJup":
            mass_min,

        "Bobcat_Evo_Mass_Max_MJup":
