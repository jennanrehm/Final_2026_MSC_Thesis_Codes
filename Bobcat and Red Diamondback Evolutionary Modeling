        f"Evolutionary mass range = "
        f"{mass_min:.2f} - "
        f"{mass_max:.2f} MJup"
    )

    print(
        f"Evolutionary radius range = "
        f"{radius_min:.3f} - "
        f"{radius_max:.3f} RJup"
    )

    print(
        f"Atmospheric radius = "
        f"{atmos_radius:.3f} +/- "
        f"{atmos_radius_error:.3f} RJup"
    )

    print(
        "Radius consistent = "
        f"{'YES' if evo_consistent else 'NO'}"
    )

    # parameters

    if len(allowed_tracks) > 0:

        print(
            "\nDerived evolutionary parameters:"
        )

        print(
            f"Evolutionary mass = "
            f"{evo_parameters['Evolutionary_Mass_Mid_MJup']:.2f}"
            f" +/- "
            f"{evo_parameters['Evolutionary_Mass_Error_MJup']:.2f}"
