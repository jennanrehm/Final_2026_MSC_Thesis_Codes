# bobcat results

def analyse_bobcat(
    target
):


    print(
        f"BOBCAT: {target}"
    )


    atmos_row = bobcat_atmos[
        bobcat_atmos["Target"] == target
    ]

    lum_row = luminosity[
        luminosity["Target"] == target
    ]

    if atmos_row.empty:

        print(
            "Atmospheric result not found."
        )

        return None

    if lum_row.empty:

        print(
            "Luminosity result not found."
        )

        return None

    atmos_row = atmos_row.iloc[0]
    lum_row = lum_row.iloc[0]

    metallicity = atmos_row[
        "Bobcat [M/H]"
    ]

    atmos_radius = atmos_row[
        "Bobcat Radius (RJup)"
    ]

    atmos_radius_error = atmos_row[
        "Bobcat Radius Error (RJup)"
    ]

    logL = lum_row[
        "log_L_Lsun"
    ]

    logL_error = lum_row[
        "log_L_error"
    ]

    logL_min = (
        logL - logL_error
    )

    logL_max = (
        logL + logL_error
    )

    age_min, age_max = (
        AGE_RANGES[target]
    )

    print(
        f"Atmospheric [M/H] = "
        f"{metallicity}"
    )

    print(
        f"Atmospheric radius = "
        f"{atmos_radius:.3f} +/- "
        f"{atmos_radius_error:.3f} RJup"
    )

    print(
        f"log(L/Lsun) = "
        f"{logL:.4f} +/- "
        f"{logL_error:.4f}"
    )

    print(
        f"Age range = "
        f"{age_min:g} - "
        f"{age_max:g} Gyr"
    )

    evo, used_mh = (
        load_bobcat_grid(
            metallicity
        )
    )

    # find intersections

    allowed_tracks = (
        find_allowed_tracks(
            evo=evo,
            age_min=age_min,
            age_max=age_max,
            logL_min=logL_min,
            logL_max=logL_max
        )
    )

    print(
        f"Evolutionary mass tracks "
        f"intersecting BOTH age + luminosity "
        f"constraints: "
        f"{len(allowed_tracks)}"
    )

    # all parameters

    if len(allowed_tracks) > 0:

        mass_min = (
            min(
                item["M"]
                for item in allowed_tracks
            ) * 1000
        )

        mass_max = (
            max(
                item["M"]
                for item in allowed_tracks
            ) * 1000
        )

        radius_min = (
            min(
                item["radius_min"]
                for item in allowed_tracks
            ) / 0.1028
        )

        radius_max = (
            max(
                item["radius_max"]
                for item in allowed_tracks
            ) / 0.1028
        )

        # Radius consistency with atmospheric result

        evo_consistent = (
            atmos_radius +
            atmos_radius_error
            >= radius_min
            and
            atmos_radius -
            atmos_radius_error
            <= radius_max
        )

        # Derive evolutionary parameters

        evo_parameters = (
            derive_evolutionary_parameters(
                mass_min_mjup=mass_min,
                mass_max_mjup=mass_max,
                radius_min_rjup=radius_min,
                radius_max_rjup=radius_max,
                logL=logL,
                logL_error=logL_error
            )
        )

    else:

        mass_min = np.nan
        mass_max = np.nan

        radius_min = np.nan
        radius_max = np.nan

        evo_consistent = False

        evo_parameters = {

            "Evolutionary_Mass_Mid_MJup": np.nan,
            "Evolutionary_Mass_Error_MJup": np.nan,
            "Evolutionary_Radius_Mid_RJup": np.nan,
            "Evolutionary_Radius_Error_RJup": np.nan,
            "Evolutionary_Teff_K": np.nan,
