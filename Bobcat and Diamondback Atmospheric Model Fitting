# Convolution Function

def conv_non_uniform(obspec, modspec, res):

    #Convolves atmospheric model spectrum onto JWST resolution.

    #Parameters:

    #obspec : array
      #Observed spectrum:
      #[wavelength, flux, uncertainty]

    #modspec : array
        #Model spectrum:
        #[wavelength, flux]

    #res : float
        #Resolution element


    #Returns:

   # mod_flux : array
        #Model flux sampled at JWST wavelengths

    wlobs = obspec[0]
    wlmod = modspec[0]
    Fmod = modspec[1]

    # wavelength spacing of observed spectrum

    delta1 = np.abs(
        wlobs - np.roll(wlobs, 1)
    )

    delta2 = np.abs(
        wlobs - np.roll(wlobs, -1)
    )

    delta = 0.5 * (delta1 + delta2)

    # Fix edges

    delta[0] = delta[1]
    delta[-1] = delta[-2]

    mod_flux = np.zeros(len(wlobs))

    for i in range(len(wlobs)):
        sigma = delta[i] * res / 2.355

        gaussian = np.exp(
            -((wlmod - wlobs[i]) ** 2)
            / (2 * sigma ** 2)
        )

        gaussian /= np.sum(gaussian)

        mod_flux[i] = np.sum(
            gaussian * Fmod
        )

    return mod_flux


# Chi squared fitting function

def chi2(obspec, modspec):
    
    #Calculates reduced chi-squared and best-fit scaling factor.

    #Returns:
    #chi2_value
    #R2D2 scaling factor

    # Convolve model to JWST resolution

    conv_model = conv_non_uniform(
        obspec,
        modspec,
        3.3
    )

    # Radius/distance scaling factor

    R2D2 = (
            np.sum(
                obspec[1] *
                conv_model /
                obspec[2] ** 2
            )
            /
            np.sum(
                conv_model ** 2 /
                obspec[2] ** 2
            )
    )

    # Reduced chi squared

    statistic = np.sum(
        (
                (obspec[1] - R2D2 * conv_model)
                / obspec[2]) ** 2
        )

    chi_value = (
            statistic / len(obspec[0])
    )

    if np.isnan(chi_value):
        chi_value = 1e8

    return chi_value, R2D2



# Monte Carlo Radius Uncertainty

def monte_carlo_radius(
        obspec,
        model_flux,
        best_radius,
        R2D2_best,
        distance_pc,
        distance_error_pc,
        n_samples=1000
):

    radius_samples = []

    for i in range(n_samples):

        # Perturb observed spectrum
        flux_mc = (
            obspec[1]
            +
            np.random.normal(
                0,
                obspec[2]
            )
        )

        # Perturb distance
        distance_mc = np.random.normal(
            distance_pc,
            distance_error_pc
        )

        # Recalculate scaling
        R2D2_mc = (
            np.sum(
                flux_mc *
                model_flux /
                obspec[2]**2
            )
            /
            np.sum(
                model_flux**2 /
                obspec[2]**2
            )
        )

        # Radius scales with distance and sqrt(R2D2)
        radius_mc = (
            best_radius *
            np.sqrt(
                R2D2_mc /
                R2D2_best
            )
            *
            distance_mc /
            distance_pc
        )

        radius_samples.append(radius_mc)

    return np.std(radius_samples)

# Atmospheric model fitting function

def fit_model_grid(
        model_folder,
        model_type,
        obspec,
        distance_pc,
        distance_error_pc
):

    #Fits a grid of Sonora atmospheric models.
    #Parameters:
    #model_folder : str
        #Folder containing model spectra

    #model_type : str
        #"Bobcat" or "Diamondback"

    #obspec : array
        #JWST spectrum:
        #[wavelength, flux, uncertainty]

    #distance_pc : float
        #Distance to target in pc

    #Returns:
    #results : dataframe
        #All model fits

    #best_model : dataframe row
        #Best fitting model

    #best_flux : array
        #Scaled best-fit spectrum

    # Distance conversion

    D = distance_pc * pc_to_m

    # Load model list

    if model_type == "Bobcat":

        filelist = np.array(
            [
                f for f in os.listdir(model_folder)
                if f.startswith("sp_t")
                   and f.endswith("R3K.dat")
            ]
        )


    elif model_type == "Diamondback":

        filelist = np.array(
            [
                f for f in os.listdir(model_folder)
                if f.startswith("t")
                   and f.endswith("R3K.dat")
            ]
        )

    print(
        f"{model_type}: {len(filelist)} models found"
    )

    # Create dataframe
    results = pd.DataFrame()

    results["model"] = filelist

    results["Teff"] = np.nan
    results["log g"] = np.nan
    results["MH"] = np.nan

    if model_type == "Diamondback":
        results["f_sed"] = np.nan

    results["chi2"] = np.nan
    results["radius"] = np.nan

    # Decode filenames
    for i, filename in enumerate(filelist):

        try:

            if model_type == "Bobcat":

                values = re.findall(
                    r'-?\d+\.?\d*',
                    filename
                )

                teff = float(values[0])

                gravity = float(values[1])

                metallicity = float(values[2])

                logg = np.log10(
                    gravity * 100
                )

                results.loc[i, "Teff"] = teff

                results.loc[i, "log g"] = logg

                results.loc[i, "MH"] = metallicity


            elif model_type == "Diamondback":

                teff = float(
                    re.search(
                        r't(\d+)',
                        filename
                    ).group(1)
                )

                gravity = float(
                    re.search(
                        r'g(\d+)',
                        filename
                    ).group(1)
                )

                metallicity = float(
                    re.search(
                        r'_m([+-]?\d+\.\d+)',
                        filename
                    ).group(1)
                )

                fsed = float(
                    re.search(
                        r'f(\d+)',
                        filename
                    ).group(1)
                )

                logg = np.log10(
                    gravity * 100
                )

                results.loc[i, "Teff"] = teff

                results.loc[i, "log g"] = logg

                results.loc[i, "MH"] = metallicity

                results.loc[i, "f_sed"] = fsed


    # Run chi squared fitting

    for i, model in enumerate(filelist):

        filepath = os.path.join(
            model_folder,
            model
        )

        try:

            modspec = np.loadtxt(
                filepath,
                dtype=float,
                comments="#",
                unpack=True,
            )

            if modspec.shape[0] != 2:
                print("Bad model format:", model)
                continue

            model_chi2, R2D2 = chi2(
                obspec,
                modspec
            )


            # radius calculation
            radius = (np.sqrt(R2D2) * D / Rjup )

            results.loc[i, "chi2"] = model_chi2

            results.loc[i, "radius"] = radius


        except Exception as e:

            print(
                "Skipping:",
                model
            )

            print(e)


    # Find best fit

    results = results.dropna(
        subset=["chi2"]
    )

    results_sorted = results.sort_values(
        by="chi2"
    ).reset_index(drop=True)

    print(
        results_sorted.head(5)
    )

    best_model = results_sorted.iloc[0]

    # Load best fitting spectrum

    best_spectrum = np.loadtxt(

        os.path.join(
            model_folder,
            best_model["model"]
        ),

        dtype="d",
        unpack=True,
        skiprows=2
    )

    # Convolve and scale

    convolved_best = conv_non_uniform(

        obspec,
        best_spectrum,
        3.3

    )

    _, R2D2 = chi2(
        obspec,
        best_spectrum
    )

    best_flux = R2D2 * convolved_best

    radius_error = monte_carlo_radius(
        obspec,
        convolved_best,
        best_model["radius"],
        R2D2,
        distance_pc,
        distance_error_pc
    )

    return (
        results_sorted,
        best_model,
        best_flux,
        radius_error
    )


# Plot Best Fitting Model

def plot_best_fit(
        obspec,
        best_model,
        best_flux,
        target_name,
        model_type,
        save_folder
):
  
    #Plot the best-fitting atmospheric model.

    #Parameters:
    #obspec : observed spectrum

    #best_model : pandas Series
        #Best-fitting model parameters

    #best_flux : ndarray
        #Scaled model spectrum

    #target_name : str

    #model_type : str
        #"Bobcat" or "Diamondback"

    #save_folder : str
        #Folder to save figure


    plt.figure(figsize=(10, 6))
    plt.gcf().set_facecolor("white")
    plt.gca().set_facecolor("white")

    # Plot observed spectrum

    plt.plot(
        obspec[0],
        obspec[1],
        color="black",
        lw=1.5,
        label="JWST Spectrum"
    )


    # Plot best-fit model

    colour = "red" if model_type == "Bobcat" else "blue"

    plt.plot(
        obspec[0],
        best_flux,
        color=colour,
        lw=2,
        label=f"Best-fit Sonora {model_type} Model"
    )


    # Axes

    plt.yscale("log")

    plt.xlabel(
        "Wavelength (μm)",
        fontsize=15
    )

    plt.ylabel(
        r"Flux (W m$^{-2}$ μm$^{-1}$)",
        fontsize=15
    )


    plt.xticks(fontsize=15)
    plt.yticks(fontsize=15)


    # Parameter box

    if model_type == "Bobcat":

        parameter_text = (

            f"$T_{{eff}}$ = {best_model['Teff']:.0f} K\n"

            f"log(g) = {best_model['log g']:.2f}\n"

            f"[M/H] = {best_model['MH']:.1f}\n"

            f"$\\chi^2_\\nu$ = {best_model['chi2']:.2f}\n"

            f"Radius = {best_model['radius']:.2f} $R_{{Jup}}$"

        )

    else:

        parameter_text = (

            f"$T_{{eff}}$ = {best_model['Teff']:.0f} K\n"

            f"log(g) = {best_model['log g']:.2f}\n"

            f"[M/H] = {best_model['MH']:.1f}\n"

            f"$f_{{sed}}$ = {best_model['f_sed']:.0f}\n"

            f"$\\chi^2_\\nu$ = {best_model['chi2']:.2f}\n"

            f"Radius = {best_model['radius']:.2f} $R_{{Jup}}$"

        )

    plt.text(
        0.03,
        0.03,
        parameter_text,
        transform=plt.gca().transAxes,
        fontsize=15,
        verticalalignment="bottom",
        bbox=dict(
            boxstyle="round",
            facecolor="white",
            alpha=0.8
        )
    )

    # Legend

    plt.legend(
        fontsize=15,
        loc="best"
    )

    plt.tight_layout()

    # Save figure

    filename = (
        f"{target_name}_{model_type}_BestFit.png"
    )

    plt.savefig(

        os.path.join(
            save_folder,
            filename
        ),

        dpi=300,

        bbox_inches="tight",
        facecolor="white"

    )

    plt.show()

    plt.close()

